format ELF64

include 'Include\raylib.inc'
include 'Templates\part_equates.fasm'

; *** GENERATED EQUATES CODE ***
;GC_INSERTIONPOINT_EQUATES

section '.text' executable

extrn InitWindow
extrn LoadShaderFromMemory
extrn GetShaderLocation
extrn SetShaderValue
extrn HideCursor
extrn WindowShouldClose
extrn GetTime
extrn BeginDrawing
extrn ClearBackground
extrn BeginShaderMode
extrn DrawRectangle
extrn EndShaderMode
extrn EndDrawing
extrn UnloadShader
extrn CloseWindow
extrn IsShaderValid

public main

main:
  push	rbp
  mov	rbp, rsp
  mov   [main_rbp], rbp

  ;invoke kernel32_GetProcessHeap
  ;mov	[processHeapHandle], rax
  
  mov   rax, 89                 ; SYS_readlink
  mov   rdi, exe_path           ; "/proc/self/exe"
  mov   rsi, currentExeDirChars ; buffer
  mov   rdx, 256                ; size
  syscall                       ; returns length in rax

; *** GENERATED MAIN CODE ***
;GC_INSERTIONPOINT_MAIN
; *** END MAIN CODE ***

assert_exitpoint:
  mov   rsp, rbp
  xor   rdi, rdi                ; exit code 0
  mov   rax, 60                 ; sys_exit
  syscall
  pop   rbp
  ret


; *** GENERATED PROCEDURES (GROUND FUNCTIONS AND CLASSES) ***
;GC_INSERTIONPOINT_PROCEDURES
; *** END PROCEDURES ***


include 'Templates\part_string_linux.fasm'
include 'Templates\part_utils.fasm'
include 'Templates\part_hardcoded_library_linux.fasm'


color@_f_GC_ClearScreenPixels equ rbp+G_PARAMETER1
_f_GC_ClearScreenPixels:
  push  rbp
  mov   rbp, rsp
  mov	rcx, GC_SCREEN_WIDTH * GC_SCREEN_HEIGHT
  mov	rdx, [pixels_p]
  mov	rax, qword [color@_f_GC_ClearScreenPixels]
  push	rdi
  mov	rdi, rdx
  cld
  rep	stosd
  pop   rdi
  mov   rsp, rbp
  pop   rbp
  retn  G_STACKSPACE_1_PARAM


section '.data' writeable align 16
Negation_XMM            db 0,0,0,0,0,0,0,80h
                        db 0,0,0,0,0,0,0,80h
Negation_XMM32          db 0,0,0,80h,0,0,0,0
                        db 0,0,0,80h,0,0,0,0
main_rbp                dq 0
processHeapHandle		dq 0
currentExeDirChars      db 256 dup(0)
tmpCharSpace            db 256 dup(0)	; needed for some hardcoded_library functions

align 8
ResultBytesWritten      dq 0
ResultBytesRead         dq 0
LockObject64            dq 0
pixels_p				dq 0

scanf_int_result        dq 0
scanf_int_read          db '%d',0
scanf_string_read       db '%s',0
sprintf_float_template  db '%.10f',0 
readalltext_openmode    db 'rb',0
bool_true_tostring      db 'true',0
bool_false_tostring     db 'false',0
carriage_return_bytes	db 13,10,0
assert_errormessage	    db 13,10,'*** ASSERT ERROR ***',13,10,13,10,0
exe_path                db '/proc/self/exe',0

align 16

; *** GENERATED DATA ***
;GC_INSERTIONPOINT_DATA
; *** END DATA ***
