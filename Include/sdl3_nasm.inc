; The blend mode used in SDL_RenderCopy() and drawing operations.

SDL_BLENDMODE_NONE equ 0x00000000 	; no blending
					; dstRGBA equ srcRGBA
SDL_BLENDMODE_BLEND equ 0x00000001	; alpha blending
					; dstRGB equ (srcRGB * srcA) + (dstRGB * (1-srcA))
					; dstA equ srcA + (dstA * (1-srcA))
SDL_BLENDMODE_ADD equ 0x00000002		; additive blending
					; dstRGB equ (srcRGB * srcA) + dstRGB
					; dstA equ dstA
